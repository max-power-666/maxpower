# Skopiuj ten plik jako .env.local i uzupełnij wartościami z Supabase
# (Project Settings -> API w panelu Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://twofxnrjpklxdttgvigj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pW2zDEfp1YQq7lKMtNs3tQ_0ceDExji

# Fakturownia (https://github.com/fakturownia/api) — używane tylko po stronie serwera
# (app/api/fakturownia/sync/route.ts), NIGDY nie dawaj tu prefiksu NEXT_PUBLIC_,
# bo token trafiłby do przeglądarki.
# FAKTUROWNIA_DOMAIN to subdomena z adresu, np. dla https://twojafirma.fakturownia.pl -> "twojafirma"
# API_TOKEN: Ustawienia -> Ustawienia konta -> Integracja -> Kod autoryzacyjny API
FAKTUROWNIA_DOMAIN=twojafirma
FAKTUROWNIA_API_TOKEN=wklej-tu-token

# Service role Supabase (Project Settings -> API -> service_role) — używany TYLKO w
# app/api/fakturownia/sync/route.ts do zapisu w tabelach fakturownia_* z pominięciem RLS.
# To pełny dostęp do bazy z pominięciem zabezpieczeń — nigdy nie dawaj mu prefiksu
# NEXT_PUBLIC_ i nigdy nie używaj go nigdzie indziej niż w kodzie serwerowym.
SUPABASE_SERVICE_ROLE_KEY=wklej-tu-service-role-key

# Sekret, którym Vercel Cron (i przycisk "Odśwież") autoryzuje wywołanie
# /api/fakturownia/sync. Wygeneruj dowolny losowy ciąg, np.: openssl rand -hex 24
CRON_SECRET=wklej-tu-losowy-sekret

# Back Market Buyback API — zakładka Trade-in (lib/buyback.ts), tylko po stronie serwera.
# BACKMARKET_AUTH: nagłówek Authorization z panelu Back Market (np. "Basic xxxx...").
BACKMARKET_AUTH=Basic wklej-tu-klucz
BACKMARKET_LANG=fr-fr
BACKMARKET_UA=backmarket@recoo.io
BACKMARKET_BASE_URL=https://www.backmarket.fr

# REFURBED_API_TOKEN: token API sprzedawcy z supplier.refurbed.com (wysyłany jako "Authorization: Plain <token>").
# Bez niego synchronizacja zamówień refurbed jest pomijana. Nieużywany token wygasa po 2 miesiącach.
REFURBED_API_TOKEN=wklej-tu-token
REFURBED_UA=recoo-erp

# ERLI_API_KEY: klucz API sklepu z panelu Erli (Metoda integracji > Własna integracja po API), wysyłany jako "Authorization: Bearer <klucz>".
# Bez niego synchronizacja zamówień Erli jest pomijana.
ERLI_API_KEY=wklej-tu-klucz
ERLI_UA=recoo-erp
