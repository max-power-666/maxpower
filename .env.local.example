# Skopiuj ten plik jako .env.local i uzupełnij wartościami z Supabase
# (Project Settings -> API w panelu Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://twofxnrjpklxdttgvigj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pW2zDEfp1YQq7lKMtNs3tQ_0ceDExji

# Fakturownia (https://github.com/fakturownia/api) — używane tylko po stronie serwera
# (app/api/fakturownia/sync/route.ts), NIGDY nie dawaj tu prefiksu NEXT_PUBLIC_,
# bo token trafiłby do przeglądarki.
# FAKTUROWNIA_DOMAIN to subdomena z adresu, np. dla https://twojafirma.fakturownia.pl -> "twojafirma"
# API_TOKEN: Ustawienia -> Ustawienia konta -> Integracja -> Kod autoryzacyjny API
FAKTUROWNIA_DOMAIN=twojafirma
FAKTUROWNIA_API_TOKEN=wklej-tu-token

# Service role Supabase (Project Settings -> API -> service_role) — używany TYLKO w
# app/api/fakturownia/sync/route.ts do zapisu w tabelach fakturownia_* z pominięciem RLS.
# To pełny dostęp do bazy z pominięciem zabezpieczeń — nigdy nie dawaj mu prefiksu
# NEXT_PUBLIC_ i nigdy nie używaj go nigdzie indziej niż w kodzie serwerowym.
SUPABASE_SERVICE_ROLE_KEY=wklej-tu-service-role-key

# Sekret, którym Vercel Cron (i przycisk "Odśwież") autoryzuje wywołanie
# /api/fakturownia/sync. Wygeneruj dowolny losowy ciąg, np.: openssl rand -hex 24
CRON_SECRET=wklej-tu-losowy-sekret

# Back Market Buyback API — zakładka Trade-in (lib/buyback.ts), tylko po stronie serwera.
# BACKMARKET_AUTH: nagłówek Authorization z panelu Back Market (np. "Basic xxxx...").
BACKMARKET_AUTH=Basic wklej-tu-klucz
BACKMARKET_LANG=fr-fr
BACKMARKET_UA=backmarket@recoo.io
BACKMARKET_BASE_URL=https://www.backmarket.fr

# REFURBED_API_TOKEN: token API sprzedawcy z supplier.refurbed.com (wysyłany jako "Authorization: Plain <token>").
# Bez niego synchronizacja zamówień refurbed jest pomijana. Nieużywany token wygasa po 2 miesiącach.
REFURBED_API_TOKEN=wklej-tu-token
REFURBED_UA=recoo-erp

# ERLI_API_KEY: klucz API sklepu z panelu Erli (Metoda integracji > Własna integracja po API), wysyłany jako "Authorization: Bearer <klucz>".
# Bez niego synchronizacja zamówień Erli jest pomijana.
ERLI_API_KEY=wklej-tu-klucz
ERLI_UA=recoo-erp

# ALLEGRO_CLIENT_ID / ALLEGRO_CLIENT_SECRET: dane aplikacji z apps.developer.allegro.pl (rejestracja wymaga konta z 2FA).
# Adres przekierowania w ustawieniach aplikacji: https://TWOJA-DOMENA/api/orders/allegro-callback
# Potem Admin klika w zakładce Zamówienia "Połącz z Allegro" (zapisuje tokeny w bazie). Bez tych zmiennych sync Allegro jest pomijany.
ALLEGRO_CLIENT_ID=wklej-tu-client-id
ALLEGRO_CLIENT_SECRET=wklej-tu-client-secret
# ALLEGRO_UA: User-Agent WYGENEROWANY w panelu aplikacji Allegro (generator User-Agent) — bez niego Allegro blokuje klucz API.
ALLEGRO_UA=wklej-tu-wygenerowany-user-agent
# Opcjonalnie: sztywny adres przekierowania (musi być identyczny z wpisanym w aplikacji Allegro), np. https://recoo.vercel.app/api/orders/allegro-callback
# ALLEGRO_REDIRECT_URI=

# DHL Parcel (DHL24 WebAPI2, SOAP): DHL_PARCEL_USERNAME = "klucz APIv2" z panelu DHL24 (sekcja Integracja), DHL_PARCEL_PASSWORD = hasło do API,
# DHL_PARCEL_SAP = numer klienta SAP płatnika (7 cyfr). Bez środowiska testowego — to PRODUKCJA (przesyłkę można anulować przez API).
# Opcjonalnie DHL_PARCEL_BASE_URL (np. sandbox, jeśli DHL udostępni).
DHL_PARCEL_USERNAME=wklej-tu-klucz-apiv2
DHL_PARCEL_PASSWORD=wklej-tu-haslo
DHL_PARCEL_SAP=wklej-tu-numer-sap

# DHL Express (MyDHL API): dane z aplikacji "MyDHL API" na developer.dhl.com (API Key = Username / site ID, API Secret = Password)
# oraz numer konta nadawcy DHL Express. DHL_EXPRESS_ENV: test (domyślnie) albo production. Bez tych zmiennych zakładka Wysyłka pokazuje tylko instrukcję.
DHL_EXPRESS_API_KEY=wklej-tu-api-key
DHL_EXPRESS_API_SECRET=wklej-tu-api-secret
DHL_EXPRESS_ACCOUNT=wklej-tu-numer-konta
DHL_EXPRESS_ENV=test
# Opcjonalnie: szablon etykiety (domyślnie ECOM26_64_001 = 6x4 cala, czyli 10x15 cm)
# DHL_EXPRESS_LABEL_TEMPLATE=ECOM26_64_001

# Octopia (marketplace'y takie jak Cdiscount): dane aplikacji z panelu Octopia (API Credentials Management).
# OCTOPIA_SELLER_ID to Twój numer sprzedawcy (widoczny na tej samej stronie). Bez tych zmiennych sync Octopia jest pomijany.
OCTOPIA_CLIENT_ID=wklej-tu-client-id
OCTOPIA_CLIENT_SECRET=wklej-tu-client-secret
OCTOPIA_SELLER_ID=wklej-tu-seller-id

# Apilo (TYMCZASOWY most do Amazon, dopóki nie ma bezpośredniej integracji SP-API): APILO_BASE_URL to Twoja subdomena
# Apilo (np. https://recoo.apilo.com, bez ukośnika na końcu). APILO_CLIENT_ID/SECRET z aplikacji utworzonej w panelu
# Apilo (Administracja / API Apilo). Po ich ustawieniu Admin musi jeszcze wymienić kod autoryzacyjny w Zamówieniach
# ("Połącz z Apilo") — sam klucz nie wystarcza.
APILO_BASE_URL=https://recoo.apilo.com
APILO_CLIENT_ID=wklej-tu-client-id
APILO_CLIENT_SECRET=wklej-tu-client-secret
